{
  "manifest_version": 3,
  "name": "Trust-Aware Review Summarizer — All Sites",
  "version": "1.2",
  "description": "Works on ALL sites (Amazon, Flipkart, eBay, Walmart, any product page) — down-weights fakes and trust-rates reviews.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:8000/*",
    "http://localhost:8001/*",
    "http://localhost:8080/*",
    "http://127.0.0.1:8000/*",
    "http://127.0.0.1:8001/*",
    "http://127.0.0.1:8080/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["style.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Trust-Aware Summary"
  }
}
